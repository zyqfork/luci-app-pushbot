# 检测设备上线 - 优化版本
device_check_online() {
    local ip="$1"
    local max_retries=3
    local retry_count=0
    
    # 快速检查缓存
    [ -f "${dir}ipAddress" ] && grep -q -w "$ip" "${dir}ipAddress" && return 0
    
    # 多方法检测，提高准确性
    while [ $retry_count -lt $max_retries ]; do
        # 方法1: ARP检查
        if grep -q -w "$ip" /proc/net/arp 2>/dev/null; then
            local mac=$(grep -w "$ip" /proc/net/arp | awk '{print $4}' | head -n1)
            [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ] && return 0
        fi
        
        # 方法2: DHCP租约检查
        if [ -f "/var/dhcp.leases" ] && grep -q -w "$ip" /var/dhcp.leases; then
            return 0
        fi
        
        # 方法3: 无线接口检查
        if [ -n "$wlan_interface" ]; then
            for iface in $wlan_interface; do
                iw dev "$iface" station dump 2>/dev/null | grep -q "Station.*$ip" && return 0
            done
        fi
        
        retry_count=$((retry_count + 1))
        [ $retry_count -lt $max_retries ] && sleep 1
    done
    
    return 1
}

# 检测设备上线 - 优化版本
function up(){
    local ip="$1"
    local ip_mac=$(getmac "$ip")
    local ip_name=$(getname "$ip" "$ip_mac")
    local ip_interface=$(getinterface "$ip_mac")
    
    # 快速检查是否已在线
    device_check_online "$ip" && return
    
    # 使用更智能的ping检测
    local ping_success=0
    local ping_methods=("ping -c 1 -W 2" "arping -c 2 -w 3")
    
    for method in "${ping_methods[@]}"; do
        if command -v $(echo "$method" | awk '{print $1}') >/dev/null 2>&1; then
            if $method "$ip" >/dev/null 2>&1; then
                ping_success=1
                break
            fi
        fi
    done
    
    [ "$ping_success" -eq 0 ] && return
    
    LockFile lock
    
    # 检查黑白名单
    blackwhitelist "$ip_mac"
    local blacklist_check=$?
    
    # 如果设备在黑名单中，不发送通知
    [ "$blacklist_check" -ne 0 ] && LockFile unlock && return
    
    # 更新设备信息
    local timestamp=$(date +%s)
    local device_info="$ip $ip_mac $ip_name $timestamp $ip_interface"
    
    # 从临时下线列表中移除
    [ -f "${dir}tmp_downlist" ] && sed -i "/^$ip /d" "${dir}tmp_downlist}"
    
    # 添加到在线列表
    echo "$device_info" >> "${dir}ipAddress"
    
    # 发送通知
    if [ "$pushbot_up" -eq "1" ]; then
        local title="$ip_name 连接了你的路由器"
        local content="${str_splitline}${str_title_start}${font_green} 新设备连接${font_end}${str_title_end}"
        content="${content}${str_linefeed}${str_tab}客户端名：${str_space}${str_space}${str_space}${str_space}${str_space}${ip_name}"
        content="${content}${str_linefeed}${str_tab}客户端IP： ${str_space}${str_space}${str_space}${str_space}${ip}"
        content="${content}${str_linefeed}${str_tab}客户端MAC：${str_space}${str_space}${str_space}${str_space}${ip_mac}"
        content="${content}${str_linefeed}${str_tab}网络接口：${str_space}${str_space}${str_space}${str_space}${str_space}${ip_interface}"
        
        log $LOG_LEVEL_INFO "设备上线: $ip_name ($ip)"
        
        # 保存通知内容
        echo "$title" > "${dir}title"
        echo -n "$content" >> "${dir}content"
    fi
    
    LockFile unlock
}

