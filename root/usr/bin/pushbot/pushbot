#!/bin/sh

# PushBot - OpenWrt设备监控与推送通知系统
# 版本: 2.0 (优化版)
# 作者: 优化版本
# 功能: 设备在线监控、异常检测、推送通知

# 全局配置
SCRIPT_VERSION="2.0"
SCRIPT_NAME="pushbot"
CONFIG_SECTION="pushbot.pushbot"
BASE_DIR="/tmp/pushbot"
LOG_DIR="${BASE_DIR}"
CONFIG_DIR="/usr/bin/pushbot"
API_DIR="${CONFIG_DIR}/api"

# 日志级别
LOG_LEVEL_DEBUG=0
LOG_LEVEL_INFO=1
LOG_LEVEL_WARN=2
LOG_LEVEL_ERROR=3

# 错误代码
ERR_CONFIG=1
ERR_NETWORK=2
ERR_PERMISSION=3
ERR_DEPENDENCY=4

# 全局变量
debug_level=1
log_file="/dev/null"
pushbot_enabled=0

# 日志函数
log() {
    local level=$1
    shift
    local message="$*"
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    
    [ $level -ge $debug_level ] || return
    
    case $level in
        $LOG_LEVEL_DEBUG) local prefix="[DEBUG]" ;;
        $LOG_LEVEL_INFO)  local prefix="[INFO]" ;;
        $LOG_LEVEL_WARN)  local prefix="[WARN]" ;;
        $LOG_LEVEL_ERROR) local prefix="[ERROR]" ;;
    esac
    
    echo "${timestamp} ${prefix} ${message}" >> "${log_file}"
}

# 错误处理
error_exit() {
    local error_code=$1
    local message=$2
    log $LOG_LEVEL_ERROR "${message}"
    exit $error_code
}

# 检查依赖
check_dependencies() {
    local deps="curl jq uci ubus"
    local missing_deps=""
    
    for dep in $deps; do
        command -v "$dep" >/dev/null 2>&1 || missing_deps="$missing_deps $dep"
    done
    
    [ -z "$missing_deps" ] || error_exit $ERR_DEPENDENCY "缺少依赖:$missing_deps"
}

# 配置管理
config_init() {
    # 创建必要的目录
    mkdir -p "${BASE_DIR}" "${LOG_DIR}" 2>/dev/null || \
        error_exit $ERR_PERMISSION "无法创建目录: ${BASE_DIR}"
    
    # 设置文件权限
    chmod 755 "${BASE_DIR}" "${LOG_DIR}" 2>/dev/null
    
    # 初始化日志文件
    log_file="${LOG_DIR}/${SCRIPT_NAME}.log"
    touch "${log_file}" 2>/dev/null || log_file="/dev/null"
}

# 安全的配置读取
get_config() {
    local key=$1
    local default_value=$2
    local value
    
    value=$(uci -q get "${CONFIG_SECTION}.${key}" 2>/dev/null)
    echo "${value:-$default_value}"
}

# 批量配置读取
load_configs() {
    # 使用空格分隔的配置列表，避免数组语法
    local config_vars="pushbot_enable:0 lite_enable: device_name:OpenWrt sleeptime:30 oui_dir:0 oui_data:0 oui_url: debuglevel:1 pushbot_ipv4:0 ipv4_interface: pushbot_ipv6:0 ipv6_interface: pushbot_up:1 pushbot_down:1 cpuload_enable:0 cpuload:80 temperature_enable:0 temperature:70 regular_time: regular_time_2: regular_time_3: interval_time: up_timeout:2 down_timeout:20 timeout_retry_count:2 thread_num:5 pushbot_sheep:0 starttime: endtime: login_max_num:5 web_login_black:1 ip_black_timeout:86400 google_check_timeout:10"
    
    for config in $config_vars; do
        local key=$(echo "$config" | cut -d: -f1)
        local default=$(echo "$config" | cut -d: -f2-)
        local value=$(get_config "$key" "$default")
        eval "${key}=\"${value}\""
        log $LOG_LEVEL_DEBUG "配置加载: ${key}=${value}"
    done
    
    # 转换调试级别
    debug_level=$((debuglevel + 0))
    [ $debug_level -gt 3 ] && debug_level=1
    
    # 验证基本配置
    [ "$pushbot_enable" -eq 1 ] || error_exit $ERR_CONFIG "PushBot未启用"
}

# 网络工具函数 - 优化IP获取
network_get_wan_ip() {
    local interface="$1"
    local ip=""
    
    if [ -n "$interface" ]; then
        # 使用更现代的方式获取IP，避免过时的ifconfig
        if command -v ip >/dev/null 2>&1; then
            ip=$(ip addr show "${interface}" 2>/dev/null | \
                 grep -oE 'inet [0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | \
                 awk '{print $2}' | head -n1)
        else
            ip=$(/sbin/ifconfig "${interface}" 2>/dev/null | \
                 awk '/inet addr/ {print $2}' | \
                 awk -F: '{print $2}' | \
                 grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
        fi
    else
        # 从接口列表获取
        local interface_info=$(getinterfacelist 2>/dev/null)
        if command -v ip >/dev/null 2>&1; then
            ip=$(echo "$interface_info" | jq -r '.["ipv4-address"][0].address' 2>/dev/null)
        else
            ip=$(echo "$interface_info" | grep '"address"' | \
                 grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | head -n1)
        fi
    fi
    
    # 验证IP格式
    if echo "$ip" | grep -qE '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$'; then
        echo "$ip"
    else
        echo ""
    fi
}

network_get_host_ip() {
    local interface="$1"
    local url_list="$2"
    local max_retries=3
    local retry_count=0
    
    [ -z "$url_list" ] && return 1
    
    while [ $retry_count -lt $max_retries ]; do
        local url_count=$(echo "$url_list" | wc -l)
        local random_url=$(echo "$url_list" | sed -n "$((RANDOM % url_count + 1))p" | sed 's/\r//g')
        
        local curl_cmd="curl -k -s -4 -m 5"
        [ -n "$interface" ] && curl_cmd="$curl_cmd --interface $interface"
        
        local response=$($curl_cmd "$random_url" 2>/dev/null)
        local ip=$(echo "$response" | grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | head -n1)
        
        [ -n "$ip" ] && echo "$ip" && return 0
        
        retry_count=$((retry_count + 1))
        sleep 1
    done
    
    return 1
}

network_get_wan_ipv6() {
    local interface="$1"
    local ipv6=""
    
    if [ -n "$interface" ]; then
        ipv6=$(ip addr show "${interface}" 2>/dev/null | \
               grep -v deprecated | \
               grep -A1 'inet6 [^f:]' | \
               sed -nr ':a;N;s#^ +inet6 ([a-f0-9:]+)/.+? scope global .*? valid_lft ([0-9]+sec) .*#\2 \1#p;ta' | \
               sort -nr | head -n1 | awk '{print $2}')
    else
        ipv6=$(ip addr show 2>/dev/null | \
               grep -v deprecated | \
               grep -A1 'inet6 [^f:]' | \
               sed -nr ':a;N;s#^ +inet6 ([a-f0-9:]+)/.+? scope global .*? valid_lft ([0-9]+sec) .*#\2 \1#p;ta' | \
               sort -nr | head -n1 | awk '{print $2}')
    fi
    
    echo "$ipv6"
}

network_get_host_ipv6() {
    local interface="$1"
    local url_list="$2"
    local max_retries=3
    local retry_count=0
    
    [ -z "$url_list" ] && return 1
    
    while [ $retry_count -lt $max_retries ]; do
        local url_count=$(echo "$url_list" | wc -l)
        local random_url=$(echo "$url_list" | sed -n "$((RANDOM % url_count + 1))p" | sed 's/\r//g')
        
        local curl_cmd="curl -k -s -6 -m 5"
        [ -n "$interface" ] && curl_cmd="$curl_cmd --interface $interface"
        
        local response=$($curl_cmd "$random_url" 2>/dev/null)
        local ipv6=$(echo "$response" | grep -oE '([\da-fA-F0-9]{1,4}(:{1,2})){1,15}[\da-fA-F0-9]{1,4}' | head -n1)
        
        [ -n "$ipv6" ] && echo "$ipv6" && return 0
        
        retry_count=$((retry_count + 1))
        sleep 1
    done
    
    return 1
}

# 改进的IP获取函数
getip(){
    local type="$1"
    local result=""
    
    case "$type" in
        "wanipv4")
            result=$(network_get_wan_ip "$ipv4_interface")
            ;;
        "hostipv4")
            result=$(network_get_host_ip "$ipv4_interface" "$ipv4_urllist")
            ;;
        "wanipv6")
            result=$(network_get_wan_ipv6 "$ipv6_interface")
            ;;
        "hostipv6")
            result=$(network_get_host_ipv6 "$ipv6_interface" "$ipv6_urllist")
            ;;
    esac
    
    echo "$result"
}

# 设备管理函数
device_get_mac() {
    local ip="$1"
    local mac=""
    
    # 从缓存文件获取
    [ -f "${dir}ipAddress" ] && mac=$(grep -w "${ip}" "${dir}ipAddress" 2>/dev/null | awk '{print $2}' | head -n1)
    [ -f "${dir}tmp_downlist" ] && [ -z "$mac" ] && mac=$(grep -w "${ip}" "${dir}tmp_downlist" 2>/dev/null | awk '{print $2}' | head -n1)
    
    # 从DHCP租约获取
    [ -f "/var/dhcp.leases" ] && [ -z "$mac" ] && mac=$(grep -w "${ip}" /var/dhcp.leases 2>/dev/null | awk '{print $2}' | head -n1)
    
    # 从ARP表获取
    [ -z "$mac" ] && mac=$(grep -w "${ip}" /proc/net/arp 2>/dev/null | grep "0x2\|0x6" | awk '{print $4}' | head -n1)
    
    # 如果还是找不到，返回unknown
    [ -z "$mac" ] && mac="unknown"
    
    echo "$mac"
}

device_get_name() {
    local ip="$1"
    local mac="$2"
    local name=""
    
    # 从设备别名获取
    [ -n "$device_aliases" ] && name=$(echo "$device_aliases" | grep -i "$mac" | awk '{print $2}' | head -n1)
    
    # 从缓存文件获取
    [ -f "${dir}ipAddress" ] && [ -z "$name" ] && name=$(grep -w "${ip}" "${dir}ipAddress" 2>/dev/null | awk '{print $3}' | head -n1)
    [ -f "${dir}tmp_downlist" ] && [ -z "$name" ] && name=$(grep -w "${ip}" "${dir}tmp_downlist" 2>/dev/null | awk '{print $3}' | head -n1)
    
    # 从DHCP租约获取
    [ -f "/var/dhcp.leases" ] && [ -z "$name" ] && name=$(grep -w "${ip}" /var/dhcp.leases 2>/dev/null | awk '{print $4}' | head -n1)
    
    # 从UCI DHCP配置获取
    if [ -z "$name" ]; then
        local dhcp_config=$(uci show dhcp 2>/dev/null | grep "ip\|mac\|name")
        for config_type in "host" "domain"; do
            local config_name=$(echo "$dhcp_config" | grep -w "^dhcp.@${config_type}.*ip=.${ip}" | sed -nr 's#^dhcp.(.*).ip.*#\1#gp' | head -n1)
            [ -n "$config_name" ] && name=$(uci get "dhcp.${config_name}.name" 2>/dev/null)
            [ -n "$name" ] && break
        done
    fi
    
    # 从OUI数据库获取厂商信息
    if [ -z "$name" ] && [ "$mac" != "unknown" ]; then
        local oui=$(echo "$mac" | cut -c 1,2,4,5,7,8)
        [ -f "$oui_base" ] && name=$(grep -i "$oui" "$oui_base" 2>/dev/null | sed -nr 's#^.*16)..(.*)#\1#gp' | sed 's/ /_/g')
        [ -z "$name" ] && [ "$oui_data" -eq "4" ] && [ -n "$oui_url" ] && \
            name=$(curl -sS "${oui_url}" 2>/dev/null | grep -i "$oui" | sed -nr 's#^.*16)..(.*)#\1#gp' | sed 's/ /_/g')
    fi
    
    # 如果还是找不到，返回unknown
    [ -z "$name" ] && name="unknown"
    
    echo "$name"
}

device_get_interface() {
    local mac="$1"
    local interface=""
    
    # 从缓存文件获取
    [ -f "${dir}ipAddress" ] && interface=$(grep -i "$mac" "${dir}ipAddress" 2>/dev/null | awk '{print $5}' | head -n1)
    [ -f "${dir}tmp_downlist" ] && [ -z "$interface" ] && interface=$(grep -i "$mac" "${dir}tmp_downlist" 2>/dev/null | awk '{print $5}' | head -n1)
    
    # 从无线接口获取
    if [ -z "$interface" ] && [ -n "$wlan_interface" ]; then
        for iface in $wlan_interface; do
            local result=$(iw dev "$iface" station dump 2>/dev/null | grep -i -w "$mac")
            [ -n "$result" ] && interface="$iface" && break
        done
    fi
    
    # 从ARP表获取
    [ -z "$interface" ] && interface=$(grep -i -w "$mac" /proc/net/arp 2>/dev/null | grep "0x2\|0x6" | awk '{print $6}' | head -n1)
    
    echo "$interface"
}

# 改进的MAC地址获取函数
getmac(){
    device_get_mac "$1"
}

# 改进的主机名获取函数
getname(){
    device_get_name "$1" "$2"
}

# 改进的接口获取函数
getinterface(){
    device_get_interface "$1"
}

# 推送消息格式化
message_format() {
    local title="$1"
    local content="$2"
    local formatted_content=""
    
    # 添加标题
    if [ -n "$title" ]; then
        formatted_content="${str_splitline}${str_title_start}${title}${str_title_end}"
    fi
    
    # 添加内容
    if [ -n "$content" ]; then
        formatted_content="${formatted_content}${str_linefeed}${content}"
    fi
    
    echo "$formatted_content"
}

# 推送服务管理
push_service_send() {
    local title="$1"
    local content="$2"
    local service_config="$3"
    local max_retries=3
    local retry_count=0
    
    [ -z "$title" ] || [ -z "$content" ] && return 1
    
    while [ $retry_count -lt $max_retries ]; do
        local result=$(diy_send "$title" "$content" "$service_config" 2>/dev/null)
        [ $? -eq 0 ] && return 0
        
        retry_count=$((retry_count + 1))
        [ $retry_count -lt $max_retries ] && sleep 2
    done
    
    log $LOG_LEVEL_ERROR "推送失败: $title"
    return 1
}

# 系统监控函数
system_monitor_cpu() {
    [ "$cpuload_enable" -ne 1 ] && return
    
    local current_load=$(cat /proc/loadavg 2>/dev/null | awk '{print $1}')
    [ -z "$current_load" ] && return
    
    if [ $(echo "$current_load > $cpuload" | bc 2>/dev/null) -eq 1 ]; then
        local current_time=$(date +%s)
        [ -z "$cpuload_time" ] && cpuload_time=$current_time
        
        if [ $((current_time - cpuload_time)) -ge 300 ]; then
            local title="CPU负载过高警告"
            local content="当前CPU负载: ${current_load}，超过阈值: ${cpuload}"
            push_service_send "$title" "$content" "$jsonpath"
            cpucd_time=$current_time
        fi
    else
        cpuload_time=""
    fi
}

system_monitor_temperature() {
    [ "$temperature_enable" -ne 1 ] && return
    
    local current_temp=$(soc_temp)
    [ -z "$current_temp" ] && return
    
    if [ $(echo "$current_temp > $temperature" | bc 2>/dev/null) -eq 1 ]; then
        local current_time=$(date +%s)
        [ -z "$temperature_time" ] && temperature_time=$current_time
        
        if [ $((current_time - temperature_time)) -ge 300 ]; then
            local title="CPU温度过高警告"
            local content="当前CPU温度: ${current_temp}°C，超过阈值: ${temperature}°C"
            push_service_send "$title" "$content" "$jsonpath"
            temperaturecd_time=$current_time
        fi
    else
        temperature_time=""
    fi
}

# 网络连接检测
network_check_connectivity() {
    local test_urls="https://www.baidu.com https://www.qq.com https://www.163.com"
    local timeout=5
    local success=0
    
    for url in $test_urls; do
        local result=$(curl -k -s -w "%{http_code}" -m $timeout "$url" -o /dev/null 2>/dev/null)
        [ "$result" = "200" ] && success=1 && break
    done
    
    return $((1 - success))
}

# 设备状态管理
device_update_status() {
    local ip="$1"
    local mac="$2"
    local name="$3"
    local status="$4"  # "up" or "down"
    local timestamp=$(date +%s)
    
    [ -z "$ip" ] || [ -z "$mac" ] && return 1
    
    local device_file="${dir}/device_${mac//:/_}.status"
    
    if [ "$status" = "up" ]; then
        echo "$timestamp $ip $name up" > "$device_file"
        log $LOG_LEVEL_INFO "设备上线: $name ($ip)"
    else
        [ -f "$device_file" ] && rm -f "$device_file"
        log $LOG_LEVEL_INFO "设备离线: $name ($ip)"
    fi
    
    return 0
}

device_get_status() {
    local mac="$1"
    [ -z "$mac" ] && return 1
    
    local device_file="${dir}/device_${mac//:/_}.status"
    [ -f "$device_file" ] && cat "$device_file" && return 0
    
    return 1
}

# 初始化设置信息
read_config() {
    # 基础配置读取
    get_config "pushbot_enable" "lite_enable" "device_name" "sleeptime" "oui_dir" "oui_data" "oui_url" "debuglevel" "device_aliases" \
    "pushbot_ipv4" "ipv4_interface" "pushbot_ipv6" "ipv6_interface" "pushbot_up" "pushbot_down" "cpuload_enable" "cpuload" "temperature_enable" "temperature" \
    "regular_time" "regular_time_2" "regular_time_3" "interval_time" \
    "web_logged" "ssh_logged" "web_login_failed" "ssh_login_failed" "login_max_num" "web_login_black" "ip_white_list" "ip_black_timeout" \
    "pushbot_sheep" "starttime" "endtime" "pushbot_whitelist" "pushbot_blacklist" "pushbot_interface" "MAC_online_list" "MAC_offline_list" \
    "up_timeout" "down_timeout" "timeout_retry_count" "thread_num" "soc_code" "pve_host" "pve_port"\
    "err_enable" "err_sheep_enable" "err_device_aliases" "network_err_event" "system_time_event" "autoreboot_time" "network_restart_time" "public_ip_event" "public_ip_retry_count" \
    "jsonpath" "dd_webhook" "qywx_corpid" "qywx_agentid" "qywx_corpsecret" "qywx_touser" "we_webhook" "pp_token" "pp_channel" "pp_webhook" "pp_topic_enable" "pp_topic" "fs_webhook" "pushdeer_key" "pushdeer_srv_enable" "pushdeer_srv" "bark_srv_enable" "bark_srv" "bark_token" "bark_sound" "bark_icon" "bark_icon_enable" "bark_level"
    
    # 依赖版本检测
    for str_version in "iputils-arping" "curl" "iw"; do
        if [ -e "/bin/opkg" ]; then
            eval $(echo ${str_version:0:2}"_version")=$(opkg list-installed 2>/dev/null | grep -w "^${str_version}" | awk '{print $3}')
        else
            eval $(echo ${str_version:0:2}"_version")=$(apk list -I 2>/dev/null | grep -w "^${str_version}" | awk '{print $3}')
        fi
    done

    # 路径和文件设置
    dir="/tmp/pushbot/"
    mkdir -p "${dir}"
    tempjsonpath="/tmp/pushbot/temp.json"
    ip_blacklist_path="/usr/bin/pushbot/api/ip_blacklist"
    
    [ ! -z "$oui_dir" ] && [ "$oui_dir" -eq "1" ] && oui_base="${dir}oui_base.txt" || oui_base="/usr/bin/pushbot/oui_base.txt"
    debuglevel=$(echo "$debuglevel" | tr -d ' ')
    [ -z "$debuglevel" ] && logfile="/dev/null" || logfile="${dir}pushbot.log"
    
    # 列表处理
    pushbot_blacklist=$(echo "$pushbot_blacklist" | sed 's/ /\n/g' 2>/dev/null)
    pushbot_whitelist=$(echo "$pushbot_whitelist" | sed 's/ /\n/g' 2>/dev/null)
    device_aliases=$(echo "$device_aliases" | sed 's/ /\n/g' | sed 's/-/ /' 2>/dev/null)
    err_device_aliases=$(echo "$err_device_aliases" | sed 's/ /\n/g' 2>/dev/null)
    ip_white_list=$(echo "$ip_white_list" | sed 's/ /\n/g' 2>/dev/null)
    
    mark_mac_list="${MAC_online_list} ${MAC_offline_list}"
    mark_mac_list=$(echo "$mark_mac_list" | sed 's/ /\n/g' | sed 's/-/ /' 2>/dev/null)
    
    # URL列表
    ipv4_urllist=$(cat /usr/bin/pushbot/api/ipv4.list 2>/dev/null)
    ipv6_urllist=$(cat /usr/bin/pushbot/api/ipv6.list 2>/dev/null)
    
    # 默认值设置
    [ -z "$pushbot_ipv4" ] && pushbot_ipv4=0
    [ -z "$pushbot_ipv6" ] && pushbot_ipv6=0
    [ "$iw_version" ] && wlan_interface=$(iw dev 2>/dev/null | grep Interface | awk '{print $2}')
    
    [ -z "$up_timeout" ] || [ "$up_timeout" -eq "0" ] && up_timeout="2"
    [ -z "$down_timeout" ] || [ "$down_timeout" -eq "0" ] && down_timeout="20"
    down_timeout=$(expr ${down_timeout} / 2 + 1)
    
    [ -z "$timeout_retry_count" ] && timeout_retry_count="2"
    [ "$timeout_retry_count" -eq "0" ] && timeout_retry_count="1"
    
    [ ! -z "$bark_token" ] && [ -z "$bark_srv" ] && bark_srv="https://api.day.app"
    [ ! -z "$pushdeer_key" ] && [ -z "$pushdeer_srv" ] && pushdeer_srv="https://api2.pushdeer.com"
    
    # JSON格式化字符串
    if [ -f "$jsonpath" ]; then
        str_title_start=$(/usr/bin/jq -r '.str_title_start' "${jsonpath}" 2>/dev/null)
        str_title_end=$(/usr/bin/jq -r '.str_title_end' "${jsonpath}" 2>/dev/null)
        str_linefeed=$(/usr/bin/jq -r '.str_linefeed' "${jsonpath}" 2>/dev/null)
        str_splitline=$(/usr/bin/jq -r '.str_splitline' "${jsonpath}" 2>/dev/null)
        str_space=$(/usr/bin/jq -r '.str_space' "${jsonpath}" 2>/dev/null)
        str_tab=$(/usr/bin/jq -r '.str_tab' "${jsonpath}" 2>/dev/null)
        font_red=$(/usr/bin/jq -r '.font_red' "${jsonpath}" 2>/dev/null)
        font_green=$(/usr/bin/jq -r '.font_green' "${jsonpath}" 2>/dev/null)
        font_green2=$(/usr/bin/jq -r '.font_green2' "${jsonpath}" 2>/dev/null)
        font_blue=$(/usr/bin/jq -r '.font_blue' "${jsonpath}" 2>/dev/null)
        font_purple=$(/usr/bin/jq -r '.font_purple' "${jsonpath}" 2>/dev/null)
        font_end=$(/usr/bin/jq -r '.font_end' "${jsonpath}" 2>/dev/null)
        font_end2=$(/usr/bin/jq -r '.font_end2' "${jsonpath}" 2>/dev/null)
        percentsym=$(/usr/bin/jq -r '.percentsym' "${jsonpath}" 2>/dev/null)
        boldstar=$(/usr/bin/jq -r '.boldstar' "${jsonpath}" 2>/dev/null)
