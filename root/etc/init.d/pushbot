#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
	state=`pgrep -f "/usr/bin/pushbot/pushbot"`
	if [ ! -z "$state" ]; then
		restart
		return 0
	fi
	# 程序内部会 daemon(0,0)，父进程立即退出，子进程常驻，无需 nohup/&
	/usr/bin/pushbot/pushbot
	echo "pushbot is starting now ..."
}

stop() {
	kill -9 `pgrep -f "/usr/bin/pushbot/pushbot"` 2>/dev/null
	echo "pushbot exit ..."
}

restart(){
	stop
	sleep 1
	start
	echo "restarted."
}
